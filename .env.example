# ---- JoStrong environment ------------------------------------------------
# Copy to .env.local for development. In Vercel set these in Project Settings.
# NEVER commit real values. Leave the Supabase values empty to run in
# "this device only" mode (no accounts, data stays in the browser).

# Public (safe for the browser): your Supabase project URL and anon/publishable key
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Used ONLY by account deletion and admin health routes.
# Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL (used for auth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Web push (optional). Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Cron endpoint secret for reminder dispatch (Vercel Cron sends it as Bearer)
CRON_SECRET=

# Future AI coach extension point. Disabled unless explicitly set to "true".
AI_COACH_ENABLED=false
